# Application secret key (for hashing/signing)
SECRET_KEY=your_secret_key_here

# Email credentials (for Nodemailer)
EMAIL_USER=your_email_here
EMAIL_PASS=your_generated_app_password

# API + frontend URLs
VITE_REACT_APP_BACKEND_BASEURL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Environment (development | production)
NODE_ENV=development

# JWT secret (must match frontend)
JWT_SECRET=your_jwt_secret_here

# MongoDB connection string
MONGO_URI=your_mongodb_connection_string_here

# Google Gemini key for the AI assistant (server only, never VITE_)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: which Gemini model to use (default gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# First admin account, created on startup if it does not exist (leave empty to skip)
ADMIN_EMAIL=
ADMIN_PASSWORD=
